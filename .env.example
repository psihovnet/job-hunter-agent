# Получить через @BotFather в Telegram -> команда /newbot
TELEGRAM_BOT_TOKEN=

# Написать боту любое сообщение, затем открыть в браузере
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# и взять значение поля chat.id. Только этот chat_id сможет управлять ботом.
TELEGRAM_CHAT_ID=

# Получить на https://my.telegram.org -> API development tools
# (нужны для чтения Telegram-каналов через Telethon, sources/telegram_channels.py)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Как часто проверять каналы, в минутах
POLL_INTERVAL_MINUTES=60

# За сколько часов назад читать сообщения Telegram-каналов
TG_CHANNEL_LOOKBACK_HOURS=24
